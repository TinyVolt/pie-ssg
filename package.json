{
  "name": "@tinyvolt/pie",
  "version": "0.2.0",
  "description": "A Markdown-based SSG for interactive science explainers. Create a site with: npx @tinyvolt/pie init my-site",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TinyVolt/pie-ssg.git"
  },
  "exports": {
    "./vite": "./vite.ts"
  },
  "bin": {
    "pie": "init/index.js"
  },
  "files": [
    "src",
    "vite.ts",
    "init",
    "pages",
    "functions",
    "nodes",
    "styles",
    "layouts",
    "public",
    "site.yml",
    ".nvmrc"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/view": "6.43.14",
    "@jax-js/jax": "0.1.25",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "1.0.0",
    "@solidjs/start": "2.0.6",
    "codemirror": "6.0.2",
    "@lezer/highlight": "1.2.5",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "nitro": "3.0.260610-beta"
  },
  "peerDependencies": {
    "solid-js": "1.9.14",
    "vite": "8.1.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "^24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "solid-js": "1.9.14",
    "typescript": "7.0.2",
    "vite": "8.1.4"
  },
  "license": "MIT"
}
